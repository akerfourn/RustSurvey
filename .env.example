# Optional: export these variables before running the server.
# The server does not automatically load this file or .env.
# Leave BIND_ADDRESS unset to select a free port automatically in development.
# An explicit address uses a strict port; :0 asks the OS for a free port.
BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=sqlite://rustsurvey.db?mode=rwc
