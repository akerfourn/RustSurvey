# LOCAL DEVELOPMENT / TESTS ONLY. Copy this file to .env at the project root.
# Read by the Rust backend; existing environment variables take precedence.
# Keep BIND_ADDRESS commented to select a free port automatically in development.
# BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=sqlite://rustsurvey.db?mode=rwc
# Use DATABASE_URL=sqlite::memory: for a volatile database.

# Public test credentials; choose a private password outside local testing.
# These values create only the first account, never reset an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rustsurvey-dev-only

# Local HTTP only. Use true behind HTTPS outside local testing.
ADMIN_COOKIE_SECURE=false
