# LOCAL DEVELOPMENT / TESTS ONLY. Copy this file to .env at the project root.
# Read by the Rust backend; existing environment variables take precedence.
# Keep BIND_ADDRESS commented to select a free port automatically in development.
# BIND_ADDRESS=127.0.0.1:3000
# Optional compiled client on the same origin as the API, after npm run build.
# STATIC_ASSETS_DIRECTORY=web/dist
DATABASE_URL=sqlite://.data/rustsurvey.db?mode=rwc
# Use DATABASE_URL=sqlite::memory: for a volatile database.

# Local object storage. Existing SQL objects remain readable in file mode.
OBJECT_STORE_BACKEND=file
OBJECT_STORE_DIRECTORY=.data/media
# OBJECT_STORE_BACKEND=sql keeps binary objects in the database.

# Optional private S3 storage; see docs/s3-storage.md. No credentials in the browser.
# OBJECT_STORE_BACKEND=s3
# S3_ENDPOINT=https://s3.example.invalid
# S3_BUCKET=rustsurvey-private
# S3_REGION=us-east-1
# S3_PREFIX=rustsurvey/v1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_ALLOW_HTTP_LOOPBACK=false

# Participant writes: two active operations, up to eight waiting for 250 ms.
# Accepted range: 0..32; zero keeps immediate rejection when both slots are busy.
COLLECTION_WRITE_QUEUE_CAPACITY=8

# Public test credentials; choose a private password outside local testing.
# These values create only the first account, never reset an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rustsurvey-dev-only

# Allow short, nonempty bootstrap passwords in debug builds (npm run dev) only.
DEV_ALLOW_WEAK_PASSWORDS=false

# Local HTTP only. Use true behind HTTPS outside local testing.
ADMIN_COOKIE_SECURE=false
