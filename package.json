{
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "name": "rustsurvey",
  "packageManager": "npm@11.11.0",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace web",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "check:all": "npm run check && npm run check:rust",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings && cargo test --workspace --all-features --locked",
    "dev": "node web/scripts/dev.mjs",
    "dev:backend": "cargo run -p rustsurvey-server --locked",
    "dev:web": "npm run dev --workspace web",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "npm test --workspace web",
    "test:databases": "node scripts/test-databases.mjs",
    "test:storage": "cargo build -p rustsurvey-server --locked && node scripts/test-local-storage.mjs",
    "typecheck": "npm run typecheck --workspace web"
  },
  "type": "module",
  "workspaces": [
    "web"
  ]
}
